# LLM provider: anthropic | gemini | groq  (anthropic only for final verification)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional per-role model overrides, e.g. GEMINI_PLANNER_MODEL, GEMINI_WRITER_MODEL, GEMINI_LIGHT_MODEL

# Ordered search providers (tavily) at least one needs a key
SEARCH_PROVIDERS=tavily
TAVILY_API_KEY=

QDRANT_URL=http://localhost:6335
DATABASE_URL=sqlite:///insightforge.db
PERSONAS_FILE=users.yml
CHECKPOINT_DATABASE_URL=sqlite:///insightforge-checkpoints.db

# API (T10). SESSION_SECRET signs the persona cookie (at least 32 characters); the app refuses
# to start without it. Persona selection is not authentication. Generate a random value with
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
RUN_CONCURRENCY=2
RUN_QUEUE_LIMIT=2
SSE_MAX_STREAM_SECONDS=60

# T15 public Report links. SHARE_JWT_SECRET may be left blank to reuse SESSION_SECRET.
# WEB_ORIGIN is the Next.js origin Chromium opens for PDF rendering.
SHARE_JWT_SECRET=
SHARE_LINK_TTL_DAYS=7
WEB_ORIGIN=http://localhost:3000

# Retention (T13): days after a Run's Report (or its failure) before raw material nothing
# retained refers to is removed by the daily sweep. A positive whole number.
RETENTION_DAYS=30

# Runtime estimate (T14): seconds shown before submit, as base + PDFs x PDF_INGEST + one cost
# per enabled source type. A heuristic, not a promise; recalibrate against real Run timings.
RUNTIME_ESTIMATE_BASE_SECONDS=30
RUNTIME_ESTIMATE_PDF_INGEST_SECONDS=15
RUNTIME_ESTIMATE_WEB_SECONDS=45
RUNTIME_ESTIMATE_DOCUMENTS_SECONDS=30
RUNTIME_ESTIMATE_MEMORY_SECONDS=15
